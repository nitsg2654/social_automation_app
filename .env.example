# MySQL 8.4 target database (used by Docker Compose)
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=n8n_social
MYSQL_USER=social_app
MYSQL_PASSWORD=replace-with-a-strong-app-password
MYSQL_PUBLISHED_PORT=3307

# n8n generation webhook reachable from the social-dashboard container
N8N_GENERATE_WEBHOOK_URL=http://host.docker.internal:5678/webhook/generate-social-post

# Existing PostgreSQL source, used only by the one-time migration script.
# Prefer 127.0.0.1 when running the script on the Windows host and PostgreSQL publishes port 5432.
PG_SOURCE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/n8n_social
PG_SOURCE_SCHEMA=public
MYSQL_MIGRATION_HOST=127.0.0.1
